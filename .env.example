# Copy to .env and fill in. Nothing here is committed.

# ---------------------------------------------------------------------------
# BLOCKER 1 — Notion.
# notion.so/my-integrations -> New integration -> Internal -> copy the secret.
# Then open your Dashboard page -> ... -> Connections -> add the integration.
# Children inherit access, so sharing Dashboard covers every database below it.
# ---------------------------------------------------------------------------
NOTION_TOKEN=

# ---------------------------------------------------------------------------
# BLOCKER 2 — OpenRouter, used when the local model isn't strong enough.
# openrouter.ai/keys
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# ---------------------------------------------------------------------------
# Local model (Ollama). Nothing to fill in — just make sure Ollama is running.
# ---------------------------------------------------------------------------
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# ---------------------------------------------------------------------------
# LectureSynth. Blocked from my build container, so this is unverified.
# If it needs a token or a different base URL, set them here.
# ---------------------------------------------------------------------------
LECTURESYNTH_BASE_URL=https://shorts-employee-umbilical.ngrok-free.dev
LECTURESYNTH_TOKEN=

# ---------------------------------------------------------------------------
# Ports. Change only if something else is already using them.
# ---------------------------------------------------------------------------
JARVIS_BUS_PORT=8765
JARVIS_EXTENSION_PORT=8766
